{
	"name": "sitegeist-neos-base-distribution",
	"private": true,
	"workspaces": [
		"DistributionPackages/*"
	],
	"devDependencies": {
		"@tailwindcss/cli": "^4.0.6",
		"@tailwindcss/postcss": "^4.0.6",
		"prettier": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.5.13",
		"tailwindcss": "^4.0.6",
		"typescript": ">=4.4",
		"vite": "7.3.1"
	},
	"engines": {
		"node": "^24"
	},
	"packageManager": "yarn@3.2.1",
	"scripts": {
		"cleanup:node": "find . -name 'node_modules' -type d -prune -print -exec rm -rf '{}' \\;",
		"build": "yarn workspaces foreach --parallel --verbose --interlaced run build",
		"watch": "yarn workspaces foreach --parallel --verbose --interlaced -j unlimited run watch",
		"lint": "yarn workspaces foreach --parallel --verbose --interlaced run lint",
		"test": "yarn workspaces foreach --parallel --verbose --interlaced run test",
		"format": "prettier -c '**/*.{ts,tsx}'",
		"format:fix": "prettier -w '**/*.{ts,tsx}'"
	}
}
