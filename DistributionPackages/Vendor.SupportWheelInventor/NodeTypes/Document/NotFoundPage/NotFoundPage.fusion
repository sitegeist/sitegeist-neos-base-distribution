prototype(Vendor.SupportWheelInventor:Document.NotFoundPage) < prototype(Neos.Fusion:Component) {
    renderer = Vendor.SupportWheelInventor:Document.Base {
        body = Vendor.Shared:Layout.Page {
            presentationObject = ${SupportWheelInventor.NotFoundPage.renderAsDocument(documentNode, site, Neos.Node.subgraphForNode(documentNode), renderingMode.isEdit)}
        }
    }
    prototype(Neos.Neos:Page) {
        httpResponseHead {
            statusCode = 404
        }
    }
}

error {
    @context.notfoundDocument = ${SupportWheelInventor.NotFound.resolve(site)}

    404 {
        @position = 'start'
        condition = ${statusCode == 404 && notfoundDocument}
        renderer = Neos.Fusion:Renderer {
            @context {
                node = ${notfoundDocument}
                documentNode = ${notfoundDocument}
            }
            renderPath = '/root'
        }
    }
}
