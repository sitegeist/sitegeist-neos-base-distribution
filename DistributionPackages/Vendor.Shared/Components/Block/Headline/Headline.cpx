from "./HeadlineTag.cpx" import { HeadlineTag }
from "./HeadlineVariant.cpx" import { HeadlineVariant }
from "./HeadlineSize.cpx" import { HeadlineSize }

export component Headline {

    content: slot
    variant: HeadlineVariant
    size: HeadlineSize
    tag: HeadlineTag

    render
        <element
            tagName={tag}
            class={[
                "[Block.Headline ({variant}, {size})] w-full",
                match (size) {
                    HeadlineSize.SIZE_SM -> "head-h4 lg:head-hl5",
                    HeadlineSize.SIZE_MD -> "head-hl6 sm:head-hl3 lg:head-hl4 xl:head-hl5",
                    HeadlineSize.SIZE_LG -> "head-hl6 sm:head-hl5 lg:head-hl5 xl:head-hl4",
                    HeadlineSize.SIZE_XL -> "head-hl5 sm:head-hl3 lg:head-hl2 xl:head-hl1",
                    default -> "",
                },
                match (variant) {
                    HeadlineVariant.VARIANT_UPPERCASE -> "uppercase",
                    default -> "",
                },
            ]}
        >
            {content}
        </element>
}
