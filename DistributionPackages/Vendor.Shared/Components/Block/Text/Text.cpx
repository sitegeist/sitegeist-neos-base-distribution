from "./TextColumns.cpx" import { TextColumns }
from "../../Layout/Grid/Grid.cpx" import { Grid }

export component Text {

    columns: TextColumns
    content: slot

    render
        <Grid>
            <div
                data-component="Text"
                class={[
                    "[Block.Text ({columns})]",
                    "col-span-full",
                    match (columns) {
                        TextColumns.COLUMNS_TWO_COLUMNS -> "sm:columns-2",
                        default -> "",
                    },
                ]}
            >
                {content}
            </div>
        </Grid>
}
