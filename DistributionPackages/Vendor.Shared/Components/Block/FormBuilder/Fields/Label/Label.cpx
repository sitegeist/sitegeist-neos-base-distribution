from "Sitegeist.PaperTiger.CPX/Label/LabelProps.cpx" import { LabelProps }

export component Label {
    label: LabelProps

    render
        <label for={label.inputId} class="papertiger-field__label" data-custom-label>
            <span class="papertiger-field__label-text">{label.label}</span>
            {(label.isRequired !== true && label.label !== null)
                ? <span class="papertiger-field__optional">(optional)</span>
                : null}
            {(label.isRequired === true && label.label !== null)
                ? <span class="papertiger-field__required">*</span>
                : null}
        </label>
}
