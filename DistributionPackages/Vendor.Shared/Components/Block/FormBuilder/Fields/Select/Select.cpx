from "Sitegeist.PaperTiger.CPX/Field/SelectField/SelectField.cpx" import { SelectField }
from "Sitegeist.PaperTiger.CPX/Field/SelectField/SelectFieldProps.cpx" import { SelectFieldProps }
from "../InvalidIcon/InvalidIcon.cpx" import { InvalidIcon }

export component Select {
    field: SelectFieldProps
    content: slot

    render
        <div class="relative">
            <SelectField field={field}>
                {content}
            </SelectField>
            <InvalidIcon />
        </div>
}
