export component Button {
    field: ButtonFieldProps

    render
        <button
            type="submit"
            class="papertiger-field__button papertiger-field__button--submit"
        >
            <Icon
                icon="spinner"
                class="papertiger-field__button-spinner h-20 w-20 mr-8 animate-spin"
            />
            <span class="papertiger-field__button-label">{field.label}</span>
