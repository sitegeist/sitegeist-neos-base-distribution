from "../Icon/Icon.cpx" import { Icon }
from "../Link/Link.cpx" import { Link }
from "../Link/LinkStruct.cpx" import { LinkStruct }
from "../Link/LinkVariant.cpx" import { LinkVariant }
from "./SiteFooterItem.cpx" import { SiteFooterItem }

export component SiteFooter {
    primaryMenuTitle: slot
    primaryNavigationItems: slot
    secondaryMenuTitle: slot
    secondaryNavigationItems: slot
    thirdMenuTitle: slot
    thirdNavigationItems: slot
    facebookLinkStruct: ?LinkStruct
    instagramLinkStruct: ?LinkStruct
    xingLinkStruct: ?LinkStruct
    xLinkStruct: ?LinkStruct
    linkedinLinkStruct: ?LinkStruct

    render
        <footer
            data-component="SiteFooter"
            class={[
                "group/SiteFooter col-span-full mt-auto bg-brand-grey",
                "grid grid-cols-subgrid"
            ]}
        >
            <div class="col-span-content-full grid grid-cols-1 lg:grid-cols-4 gap-24 py-24">
                <SiteFooterItem title={primaryMenuTitle}>
                    <div class="flex flex-col gap-8">{primaryNavigationItems}</div>
                </SiteFooterItem>
                <SiteFooterItem title={secondaryMenuTitle}>
                    <div class="flex flex-col gap-8">{secondaryNavigationItems}</div>
                </SiteFooterItem>
                <SiteFooterItem title={thirdMenuTitle}>
                    <div class="flex flex-col gap-8">{thirdNavigationItems}</div>
                </SiteFooterItem>
                <SiteFooterItem title="Folgen Sie uns!">
                    <div class="flex flex-wrap gap-16 mt-auto">
                        {facebookLinkStruct
                            ? <Link
                                link={facebookLinkStruct}
                                variant={LinkVariant.VARIANT_DEFAULT}
                                component={null}
                            >
                                <Icon icon="facebook" class="h-24 w-24" />
                            </Link>
                            : null}
                        {instagramLinkStruct
                            ? <Link
                                link={instagramLinkStruct}
                                variant={LinkVariant.VARIANT_DEFAULT}
                                component={null}
                            >
                                <Icon icon="instagram" class="h-24 w-24" />
                            </Link>
                            : null}
                        {xingLinkStruct
                            ? <Link
                                link={xingLinkStruct}
                                variant={LinkVariant.VARIANT_DEFAULT}
                                component={null}
                            >
                                <Icon icon="xing" class="h-24 w-24" />
                            </Link>
                            : null}
                        {xLinkStruct
                            ? <Link
                                link={xLinkStruct}
                                variant={LinkVariant.VARIANT_DEFAULT}
                                component={null}
                            >
                                <Icon icon="x" class="h-24 w-24" />
                            </Link>
                            : null}
                        {linkedinLinkStruct
                            ? <Link
                                link={linkedinLinkStruct}
                                variant={LinkVariant.VARIANT_DEFAULT}
                                component={null}
                            >
                                <Icon icon="linkedin" class="h-24 w-24" />
                            </Link>
                            : null}
                    </div>
                </SiteFooterItem>
            </div>
        </footer>
}
