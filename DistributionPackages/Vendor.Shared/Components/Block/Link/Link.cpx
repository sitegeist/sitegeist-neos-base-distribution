from "./LinkStruct.cpx" import { LinkStruct }
from "./LinkVariant.cpx" import { LinkVariant }

export component Link {

    content: slot
    link: LinkStruct
    component: ?string
    variant: LinkVariant

    render
        <a
            data-component={component ? component : "Link"}
            href={link.href}
            title={link.title}
            rel={link.rel}
            target={link.target}
            class={[
                "w-fit cursor-pointer",
                match (variant) {
                    LinkVariant.VARIANT_NONE -> "",
                    LinkVariant.VARIANT_MENU -> "font-bold hover:text-highlight"
                }
            ]}
        >
            {content}
        </a>
}
