from "./LinkStruct.cpx" import { LinkStruct }
from "./LinkVariant.cpx" import { LinkVariant }

export component Link {

    content: slot
    link: LinkStruct
    component: ?string
    variant: LinkVariant

    render
        <a
            data-component={component ? component : "Link"}
            href={link.href}
            title={link.title}
            rel={link.rel}
            target={link.target}
            class={[
                "cursor-pointer",
                match (variant) {
                    LinkVariant.VARIANT_NONE -> "",
                    LinkVariant.VARIANT_MENU_ITEM
                        -> "link-large lg:link-medium hover:text-highlight flex h-full items-center",
                    LinkVariant.VARIANT_MENU_SUB_ITEM
                        -> "link-medium lg:link-small hover:text-highlight"
                }
            ]}
        >
            {content}
        </a>
}
