from "../../../Link/Link.cpx" import { Link }
from "../../../Link/LinkStruct.cpx" import { LinkStruct }
from "../../../Link/LinkVariant.cpx" import { LinkVariant }

export component MainNavigationItem {

    link: LinkStruct
    label: string
    items: slot

    render
        <div
            data-component="MainNavigationItem"
            class="relative lg:[&>a]:flex lg:[&>a]:items-center lg:[&>a]:h-full group/navItem"
        >
            <Link
                link={link}
                variant={LinkVariant.VARIANT_MENU}
                component={null}
            >
                {label}
            </Link>

            {items ?
                <div
                    class={[
                        "max-lg:hidden pointer-events-none absolute top-full left-1/2 -translate-x-1/2 opacity-0",
                        "group-focus-within/navItem:opacity-100 group-hover/navItem:opacity-100",
                        "group-hover/navItem:pointer-events-auto transition-opacity"
                    ]}
                >
                    <sl-menu class="min-w-48 shadow-lg bg-white">
                        {items}
                    </sl-menu>
                </div>
            : null}

            {items ?
                <div class="lg:hidden pt-16 flex flex-col gap-8">
                    {items}
                </div>
            : null}
        </div>
}