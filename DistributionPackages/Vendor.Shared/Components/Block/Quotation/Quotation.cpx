from "../../Layout/Grid/ContentGrid.cpx" import { ContentGrid }
from "../Copy/Copy.cpx" import { Copy }
from "../Copy/CopySize.cpx" import { CopySize }
from "../Figure/Figure.cpx" import { Figure }

export component Quotation {
	figure: Figure | slot
	content: slot
	spokenByName: slot
	spokenByJobTitle: slot

	render
		<ContentGrid componentName="Quotation">
			<div class="col-span-full sm:col-span-4">
				<div class="w-full aspect-square rounded-full overflow-hidden">{figure}</div>
			</div>
			<div
				class="col-span-full sm:col-span-8 md:col-start-6 flex flex-col gap-16 md:gap-24 justify-center"
			>
				<div class="relative flex flex-col gap-8 pt-40">
					<span
						class="absolute top-0 left-0 md:-left-24 text-[100px] leading-[0.7] pointer-events-none z-0"
					>
						"
					</span>
					<Copy size={CopySize.SIZE_MD} content={content} />
				</div>
				<div class="flex flex-col">
					<span class="copy-medium font-bold">{spokenByName}</span>
					<span class="copy-small">{spokenByJobTitle}</span>
				</div>
			</div>
		</ContentGrid>
}
