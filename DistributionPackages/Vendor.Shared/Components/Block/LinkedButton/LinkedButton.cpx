from "../Link/Link.cpx" import { Link }
from "../Link/LinkStruct.cpx" import { LinkStruct }
from "../Link/LinkVariant.cpx" import { LinkVariant }
from "../Button/Button.cpx" import { Button }

export component LinkedButton {

    button: Button
    link: LinkStruct

    render
        <Link
            link={link}
            component="LinkedButton"
            variant={LinkVariant.VARIANT_NONE}
            inBackend={false}
        >{button}</Link>
}
