from "../Button/Button.cpx" import { Button }
from "../Button/ButtonTag.cpx" import { ButtonTag }
from "../Button/ButtonVariant.cpx" import { ButtonVariant }
from "../Copy/Copy.cpx" import { Copy }
from "../Copy/CopySize.cpx" import { CopySize }
from "../Headline/Headline.cpx" import { Headline }
from "../Headline/HeadlineSize.cpx" import { HeadlineSize }
from "../Headline/HeadlineTag.cpx" import { HeadlineTag }
from "../Headline/HeadlineVariant.cpx" import { HeadlineVariant }
from "../Link/LinkStruct.cpx" import { LinkStruct }

export component NavigationCard {
    figure: slot
    headline: slot
    text: slot
    link: ?LinkStruct

    render
        <element
            tagName={link ? "a" : "div"}
            data-component="NavigationCard"
            href={link?.href}
            title={link?.title}
            rel={link?.rel}
            target={link?.target}
            class={[
                "flex flex-col w-full h-full relative bg-brand-grey",
                link ? "cursor-pointer hover:text-highlight" : ""
            ]}
        >
            <div class="w-full aspect-4/3 overflow-hidden shrink-0">{figure}</div>
            <div class="flex flex-col justify-between p-16 gap-16 bg-brand-grey h-full">
                <Headline
                    tag={HeadlineTag.TAG_DIV}
                    size={HeadlineSize.SIZE_MD}
                    variant={HeadlineVariant.VARIANT_REGULAR}
                    content={headline}
                />
                <Copy size={CopySize.SIZE_MD} content={text} />
                <div class="mt-auto ml-auto">
                    <Button tag={ButtonTag.TAG_SPAN} variant={ButtonVariant.VARIANT_GHOST} />
                </div>
            </div>
        </element>
}
