from "../../Link/LinkStruct.cpx" import { LinkStruct }

export component DownloadsItem {
    media: slot
    headline: slot
    primaryMetaHeadline: slot
    secondaryMetaHeadline: slot
    link: ?LinkStruct

    render
        <element
            tagName={link ? "a" : "div"}
            data-component="DownloadsItem"
            href={link?.href}
            title={link?.title}
            rel={link?.rel}
            target={link?.target}
            class={[
                "p-16 flex flex-col justify-between h-full gap-16 bg-brand-grey",
                link ? "cursor-pointer hover:text-highlight" : ""
            ]}
        >
            <div class="flex gap-24 h-full items-stretch">
                <div class="w-1/4 aspect-3/4 flex items-start shrink-0 h-full shadow-md">
                    {media}
                </div>
                <div class="flex flex-col justify-between h-full w-full">
                    <div class="h-full flex flex-col justify-between mb-2">
                        {headline}
                        <div class="flex gap-8 justify-between mt-auto copy-medium">
                            <span>{primaryMetaHeadline}</span>
                            <span>{secondaryMetaHeadline}</span>
                        </div>
                    </div>
                </div>
            </div>
        </element>
}
