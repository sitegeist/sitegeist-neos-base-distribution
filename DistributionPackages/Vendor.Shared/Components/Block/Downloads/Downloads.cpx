from "../../Layout/Grid/ContentCollectionGrid.cpx" import { ContentCollectionGrid }
from "../../Layout/Grid/ContentCollectionGridVariant.cpx" import { ContentCollectionGridVariant }
from "../../Layout/Grid/ContentGrid.cpx" import { ContentGrid }
from "../Headline/Headline.cpx" import { Headline }
from "../Headline/HeadlineSize.cpx" import { HeadlineSize }
from "../Headline/HeadlineTag.cpx" import { HeadlineTag }
from "../Headline/HeadlineVariant.cpx" import { HeadlineVariant }

export component Downloads {
	headline: slot
	content: slot

	render
		<ContentGrid componentName="Downloads">
			<div class="col-span-full">
				<Headline
					tag={HeadlineTag.TAG_H2}
					size={HeadlineSize.SIZE_LG}
					variant={HeadlineVariant.VARIANT_REGULAR}
					content={headline}
				/>
			</div>
			<ContentCollectionGrid
				variant={ContentCollectionGridVariant.VARIANT_FOUR_COLUMNS}
				content={content}
			/>
		</ContentGrid>
}
