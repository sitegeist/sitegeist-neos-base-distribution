from "../../Layout/Grid/ContentGrid.cpx" import { ContentGrid }
from "../Headline/Headline.cpx" import { Headline }
from "../Headline/HeadlineSize.cpx" import { HeadlineSize }
from "../Headline/HeadlineTag.cpx" import { HeadlineTag }
from "../Headline/HeadlineVariant.cpx" import { HeadlineVariant }

export component Accordion {
	headline: slot
	content: slot

	render
		<ContentGrid componentName="Accordion">
			<div class="col-span-full">
				<Headline
					tag={HeadlineTag.TAG_H2}
					size={HeadlineSize.SIZE_LG}
					variant={HeadlineVariant.VARIANT_REGULAR}
					content={headline}
				/>
			</div>
			<div data-__neos-insertion-anchor class="col-span-full">{content}</div>
		</ContentGrid>
}
