from "../../Button/Button.cpx" import { Button }
from "../../Headline/Headline.cpx" import { Headline }
from "../../Headline/HeadlineSize.cpx" import { HeadlineSize }
from "../../Headline/HeadlineTag.cpx" import { HeadlineTag }
from "../../Headline/HeadlineVariant.cpx" import { HeadlineVariant }
from "../../Icon/Icon.cpx" import { Icon }
from "../../Link/LinkStruct.cpx" import { LinkStruct }
from "../../LinkedButton/LinkedButton.cpx" import { LinkedButton }

export component AccordionItem {
	headline: slot
	content: slot
	initialOpen: boolean
	inBackend: boolean
	button: Button | LinkedButton | slot

	render
		<element
			tagName={inBackend ? "div" : "details"}
			data-component="AccordionItem"
			class={[
				"w-full group/accordion last:border-b-2 last:border-brand",
				"[&:has(>summary:hover)+details>summary]:border-highlight",
				"[&:has(>summary:hover)]:border-highlight",
				inBackend ? "" : "overflow-hidden"
			]}
			open={initialOpen}
		>
			<summary
				class={[
					"w-full py-24 flex justify-between items-center",
					"border-t-2 border-brand marker:hidden hover:border-highlight",
					!inBackend ? "cursor-pointer hover:text-highlight select-none" : ""
				]}
			>
				<Headline
					tag={HeadlineTag.TAG_H2}
					size={HeadlineSize.SIZE_MD}
					variant={HeadlineVariant.VARIANT_REGULAR}
					content={headline}
				/>
				<Icon icon="plus" class="w-32 h-32 group-open/accordion:hidden" />
				<Icon icon="minus" class="w-32 h-32 hidden group-open/accordion:block" />
			</summary>
			<div class="flex flex-col gap-16 md:gap-24 pb-24 pt-2 m:pt-4 l:pt-8 xl:pt-16">
				{content}
				{button}
			</div>
		</element>
}
