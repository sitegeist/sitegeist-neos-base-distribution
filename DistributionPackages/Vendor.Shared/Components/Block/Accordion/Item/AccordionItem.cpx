from "../../Headline/Headline.cpx" import { Headline }
from "../../Headline/HeadlineSize.cpx" import { HeadlineSize }
from "../../Headline/HeadlineTag.cpx" import { HeadlineTag }
from "../../Headline/HeadlineVariant.cpx" import { HeadlineVariant }
from "../../Icon/Icon.cpx" import { Icon }

export component AccordionItem {
    headline: slot
    content: slot
    initialOpen: boolean
    inBackend: boolean
    button: slot

    render
        <>
            {inBackend
                ? <div data-component="AccordionItem" class="accordion-item w-full">
                    <div class="w-full py-24 flex justify-between items-center gap-16">
                        <Headline
                            tag={HeadlineTag.TAG_H3}
                            size={HeadlineSize.SIZE_MD}
                            variant={HeadlineVariant.VARIANT_REGULAR}
                            content={headline}
                        />
                        <Icon icon="minus" class="w-32 h-32 shrink-0" />
                    </div>
                    <div class="flex flex-col gap-16 md:gap-24 pb-24">
                        {content}
                        {button}
                    </div>
                </div>
                : <sl-details data-component="AccordionItem" class="accordion-item w-full" open={initialOpen}>
                    <div slot="summary">
                        <Headline
                            tag={HeadlineTag.TAG_H3}
                            size={HeadlineSize.SIZE_MD}
                            variant={HeadlineVariant.VARIANT_REGULAR}
                            content={headline}
                        />
                    </div>
                    <span slot="expand-icon" class="accordion-item__icon">
                        <Icon icon="plus" class="w-32 h-32" />
                    </span>
                    <span slot="collapse-icon" class="accordion-item__icon">
                        <Icon icon="minus" class="w-32 h-32" />
                    </span>
                    <div class="flex flex-col gap-16 md:gap-24">
                        {content}
                        {button}
                    </div>
                </sl-details>}
        </>
}
