export component Grid {

    component: ?string
    content: slot

    render
        <div
            data-component={component}
            class={[
                "grid grid-cols-4 sm:grid-cols-8 lg:grid-cols-12",
                "gap-x-16 md:gap-x-32",
                "gap-y-16 md:gap-y-32",
            ]}
        >
            {content}
        </div>
}
