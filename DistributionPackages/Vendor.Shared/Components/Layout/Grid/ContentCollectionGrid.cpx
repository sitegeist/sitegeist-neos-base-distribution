from "./ContentCollectionGridVariant.cpx" import { ContentCollectionGridVariant }

export component ContentCollectionGrid {
    content: slot
    variant: ContentCollectionGridVariant

    render
        <div
            data-__neos-insertion-anchor
            class={[
                "col-span-full grid grid-cols-1 gap-16 md:gap-32",
                match (variant) {
                    ContentCollectionGridVariant.VARIANT_THREE_COLUMNS ->
                        "sm:grid-cols-2 lg:grid-cols-3",
                    ContentCollectionGridVariant.VARIANT_FOUR_COLUMNS ->
                        "sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
                }
            ]}
        >
            {content}
        </div>
}
