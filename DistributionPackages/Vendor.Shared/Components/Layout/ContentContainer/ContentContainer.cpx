from "./ContentContainerTag.cpx" import { ContentContainerTag }
from "./ContentContainerVariant.cpx" import { ContentContainerVariant }

export component ContentContainer {

    tagName: ContentContainerTag
    variant: ContentContainerVariant
    content: slot
    anchorId: ?string

    render
        <element
            id={anchorId}
            data-component="ContentContainer"
            tagName={tagName}
            class={[
                "max-w-content-full mx-auto w-full",
                "px-24 sm:px-32 lg:px-56 xl:px-64",
                match (variant) {
                    ContentContainerVariant.VARIANT_REGULAR
                        -> "py-16 sm:py-24 lg:py-32",
                    ContentContainerVariant.VARIANT_NO_PADDING -> ""
                },
            ]}
        >
            {content}
        </element>
}
