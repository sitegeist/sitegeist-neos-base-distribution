from "../../Block/SiteFooter/SiteFooter.cpx" import { SiteFooter }
from "../../Block/SiteHeader/SiteHeader.cpx" import { SiteHeader }
from "../Grid/PageGrid.cpx" import { PageGrid }

export component PageBody {
    content: slot
    siteHeader: SiteHeader
    siteFooter: SiteFooter

    render
        <body>
            <PageGrid>
                {siteHeader}
                <main
                    id="main-content"
                    tabindex="-1"
                    class="col-span-full grid grid-cols-subgrid content-start outline-none"
                >
                    {content}
                </main>
                {siteFooter}
            </PageGrid>
        </body>
}
