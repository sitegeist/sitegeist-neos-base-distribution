from "../../Block/Headline/Headline.cpx" import { Headline }
from "../../Block/Headline/HeadlineTag.cpx" import { HeadlineTag }
from "../../Block/Headline/HeadlineSize.cpx" import { HeadlineSize }
from "../../Block/Headline/HeadlineVariant.cpx" import { HeadlineVariant }
from "../../Layout/Grid/Grid.cpx" import { Grid }

export component ReactExampleSSR {

    headline: slot
    appData: string
    labels: string
    renderedApplication: slot

    render
        <Grid component="ReactExampleSSR">
            <div class="col-span-full">
                <Headline
                    tag={HeadlineTag.TAG_H2}
                    size={HeadlineSize.SIZE_LG}
                    variant={HeadlineVariant.VARIANT_REGULAR}
                    content={headline}
                />
            </div>
            <div
                data-root 
                data-app-data={appData}
                data-labels={labels}
                class="col-span-full"
            >
                {renderedApplication}
            </div>
        </Grid>
}
