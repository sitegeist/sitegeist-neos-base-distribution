prototype(Vendor.Shared:Block.SiteHeader) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Vendor\\Shared\\Presentation\\Block\\SiteHeader\\SiteHeader'

    @styleguide {
        title = 'Site Header'
    }

    renderer = afx`
        <div class="[Block.SiteHeader] group bg-brand-grey w-full sticky flex flex-col max-h-20 overflow-hidden transition-[max-height] duration-500 ease-in-out data-open:max-h-[100dvh] data-open:sticky data-open:top-0" data-site-header>
            <div class="flex justify-between w-full max-w-content-full mx-auto p-[20px] min-h-touch items-center shrink-0">
                <div>
                    <Vendor.Shared:Block.Link presentationObject={presentationObject.homeLink}/>
                </div>

                <div class="flex items-center justify-end w-full h-full z-50">

                    <button class="relative flex h-8 w-8 items-center justify-center shrink-0 lg:hidden" data-menu-button>
                        <span class="relative block h-[80%] w-full">
                            <span class="absolute block bg-cta-contrast w-full origin-center transition-all duration-500 h-1 w-full top-0 group-data-open:top-1/2 group-data-open:-translate-y-1/2 group-data-open:rotate-45"></span>
                            <span class="absolute block bg-cta-contrast w-full origin-center transition-all duration-500 h-1 w-full top-1/2 -translate-y-1/2 group-data-open:scale-x-0"></span>
                            <span class="absolute block bg-cta-contrast w-full origin-center transition-all duration-500 h-1 w-full top-full -translate-y-full group-data-open:top-1/2 group-data-open:-translate-y-1/2 group-data-open:-rotate-45"></span>
                        </span>
                    </button>

                    <ul
                        class={[
                            "text-lg space-x-[48px]",
                            "hidden lg:flex items-center w-full h-full justify-end"
                        ]}
                    >
                        <Neos.Fusion:Loop items={presentationObject.mainNavigationItems} itemName="mainNavigationItem">
                            <li class="h-full"                                >
                                <div class="flex flex-col items-center h-full group">
                                    <a
                                        href={mainNavigationItem.uri}
                                        target="_self"
                                        class="flex min-h-touch h-full items-center transition headerNavigationItem"
                                    >
                                        {mainNavigationItem.label}
                                    </a>
                                    <div
                                        @if={mainNavigationItem.isActive}
                                        class={["border-b-4 border-brand-default mt-[-4px] w-full"]}>
                                    </div>
                                    <div class={[
                                            "absolute -bottom-[10px] left-0 hidden group-hover:block"
                                        ]}
                                    >
                                        <div
                                            @if={mainNavigationItem.subItems}
                                            class={[
                                                "bg-brand-grey p-space32 my-space16",
                                                "flex gap-4"
                                            ]}
                                        >
                                            <div class="flex flex-row w-screen">
                                                <div class={[
                                                            "max-w-content-full w-full mx-auto flex gap-x-[150px] justify-end",
                                                            "gap-y-space16 px-space64"
                                                        ]}>
                                                    <span class="font-canaro-semiBold">{mainNavigationItem.label}</span>
                                                    <Neos.Fusion:Loop items={mainNavigationItem.subItems}>
                                                        <div class="flex flex-col flex-wrap space-y-space16">
                                                            <Neos.Fusion:Loop
                                                                items={item}
                                                                itemName="subNavigationItem"
                                                            >
                                                                <a
                                                                    class={[
                                                                        subNavigationItem.isActive && "font-bold",
                                                                        "hover:text-brand-blueLight w-full transition headerNavigationItem"
                                                                    ]}
                                                                    href={subNavigationItem.uri}
                                                                >
                                                                    {subNavigationItem.label}
                                                                </a>
                                                            </Neos.Fusion:Loop>
                                                        </div>
                                                    </Neos.Fusion:Loop>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        </Neos.Fusion:Loop>
                    </ul>
                </div>
            </div>
            <div class="bg-warning w-full max-h-0 overflow-y-auto overflow-x-hidden grow-1 transition-[max-height] duration-500 ease-in-out group-data-open:max-h-full" data-off-canvas-menu>

            </div>
        </div>
    `
}
