prototype(Vendor.Shared:Block.SiteFooter) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Vendor\\Shared\\Presentation\\Block\\SiteFooter\\SiteFooter'

    @styleguide {
        title = 'Site Footer'
    }

    renderer = afx`
        <div class="bg-brand-grey w-full">
            <div class="w-full max-w-content-full mx-auto p-5">
                <div class="grid grid-cols-1 lg:grid-cols-4 gap-[20px] justify-items-center	">
                    <div class="text-center lg:text-left">
                        <div
                            class="mb-[20px] text-center lg:text-left font-bold"
                            @if={presentationObject.primaryMenuTitle}
                        >
                            {presentationObject.primaryMenuTitle}
                        </div>

                        <ul class="pl-0">
                            <Neos.Fusion:Loop items={presentationObject.primaryNavigationItems}>
                                <li class="list-none leading-[48px]">
                                    <Vendor.Shared:Block.Link presentationObject={item}/>
                                </li>
                            </Neos.Fusion:Loop>
                        </ul>
                    </div>

                    <div class="text-center lg:text-left">
                        <div
                            class="mb-[20px] text-center lg:text-left font-bold"
                            @if={presentationObject.secondaryMenuTitle}
                        >
                            {presentationObject.secondaryMenuTitle}
                        </div>

                        <ul class="pl-0">
                            <Neos.Fusion:Loop items={presentationObject.secondaryNavigationItems}>
                                <li class="list-none leading-[48px]">
                                    <Vendor.Shared:Block.Link presentationObject={item}/>
                                </li>
                            </Neos.Fusion:Loop>
                        </ul>
                    </div>

                    <div class="text-center lg:text-left">
                        <div
                            class="mb-[20px] text-center lg:text-left font-bold"
                            @if={presentationObject.thirdMenuTitle}
                        >
                            {presentationObject.thirdMenuTitle}
                        </div>

                        <ul class="pl-0">
                            <Neos.Fusion:Loop items={presentationObject.thirdNavigationItems}>
                                <li class="list-none leading-[48px]">
                                    <Vendor.Shared:Block.Link presentationObject={item}/>
                                </li>
                            </Neos.Fusion:Loop>
                        </ul>
                    </div>

                    <div class="text-center lg:text-left">
                        <div
                            class="mb-[20px] text-center lg:text-left font-bold"
                        >
                            Folgen Sie uns!
                        </div>

                        <ul class="pl-0 flex gap-5 h-[48px] items-center">
                            <li
                                class="contents"
                                @if={presentationObject.facebookUri}
                            >
                                <a
                                    href={presentationObject.facebookUri}
                                    title="Facebook"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="24" height="24" viewBox="0 0 24 24">
                                        <path d="M12,2C6.477,2,2,6.477,2,12c0,5.013,3.693,9.153,8.505,9.876V14.65H8.031v-2.629h2.474v-1.749 c0-2.896,1.411-4.167,3.818-4.167c1.153,0,1.762,0.085,2.051,0.124v2.294h-1.642c-1.022,0-1.379,0.969-1.379,2.061v1.437h2.995 l-0.406,2.629h-2.588v7.247C18.235,21.236,22,17.062,22,12C22,6.477,17.523,2,12,2z"></path>
                                    </svg>
                                </a>
                            </li>

                            <li
                                class="contents"
                                @if={presentationObject.instagramUri}
                            >
                                <a
                                    href={presentationObject.instagramUri}
                                    title="Instagram"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="24" height="24" viewBox="0 0 24 24">
                                        <path d="M 8 3 C 5.239 3 3 5.239 3 8 L 3 16 C 3 18.761 5.239 21 8 21 L 16 21 C 18.761 21 21 18.761 21 16 L 21 8 C 21 5.239 18.761 3 16 3 L 8 3 z M 18 5 C 18.552 5 19 5.448 19 6 C 19 6.552 18.552 7 18 7 C 17.448 7 17 6.552 17 6 C 17 5.448 17.448 5 18 5 z M 12 7 C 14.761 7 17 9.239 17 12 C 17 14.761 14.761 17 12 17 C 9.239 17 7 14.761 7 12 C 7 9.239 9.239 7 12 7 z M 12 9 A 3 3 0 0 0 9 12 A 3 3 0 0 0 12 15 A 3 3 0 0 0 15 12 A 3 3 0 0 0 12 9 z"></path>
                                    </svg>
                                </a>
                            </li>

                            <li
                                class="contents"
                                @if={presentationObject.xingUri}
                            >
                                <a
                                    href={presentationObject.xingUri}
                                    title="Xing"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="24" height="24" viewBox="0 0 24 24">
                                        <path d="M 20 2 L 4 2 C 2.898438 2 2 2.898438 2 4 L 2 20 C 2 21.101563 2.898438 22 4 22 L 20 22 C 21.101563 22 22 21.101563 22 20 L 22 4 C 22 2.898438 21.101563 2 20 2 Z M 8.398438 15.101563 L 6.199219 15.101563 C 6 15.101563 5.898438 14.898438 6 14.699219 L 8.300781 10.5 C 8.300781 10.398438 8.300781 10.300781 8.300781 10.300781 L 6.800781 7.699219 C 6.699219 7.5 6.800781 7.300781 7 7.300781 L 9.199219 7.300781 C 9.300781 7.300781 9.398438 7.300781 9.398438 7.398438 L 11.101563 10.300781 C 11.101563 10.398438 11.101563 10.5 11.101563 10.5 L 8.601563 15 C 8.601563 15.101563 8.5 15.101563 8.398438 15.101563 Z M 18 5.398438 L 13.601563 13.5 C 13.601563 13.601563 13.601563 13.699219 13.601563 13.699219 L 16.5 18.699219 C 16.601563 18.898438 16.5 19.101563 16.300781 19.101563 L 14 19.101563 C 13.898438 19.101563 13.800781 19.101563 13.800781 19 L 10.800781 13.800781 C 10.800781 13.699219 10.800781 13.601563 10.800781 13.601563 L 15.398438 5.300781 C 15.398438 5 15.5 5 15.601563 5 L 17.800781 5 C 17.898438 5 18.101563 5.199219 18 5.398438 Z"></path>
                                    </svg>
                                </a>
                            </li>

                            <li
                                class="contents"
                                @if={presentationObject.xUri}
                            >
                                <a
                                    href={presentationObject.xUri}
                                    title="X / Twitter"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="24" height="24" viewBox="0 0 24 24">
                                        <path d="M 2.8671875 3 L 9.7363281 12.818359 L 2.734375 21 L 5.3808594 21 L 10.919922 14.509766 L 15.460938 21 L 21.371094 21 L 14.173828 10.697266 L 20.744141 3 L 18.138672 3 L 12.996094 9.0097656 L 8.7988281 3 L 2.8671875 3 z"></path>
                                    </svg>
                                </a>
                            </li>

                            <li
                                class="contents"
                                @if={presentationObject.linkedinUri}
                            >
                                <a
                                    href={presentationObject.linkedinUri}
                                    title="LinkedIn"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="24" height="24" viewBox="0 0 24 24">
                                        <path d="M19,3H5C3.895,3,3,3.895,3,5v14c0,1.105,0.895,2,2,2h14c1.105,0,2-0.895,2-2V5C21,3.895,20.105,3,19,3z M9,17H6.477v-7H9 V17z M7.694,8.717c-0.771,0-1.286-0.514-1.286-1.2s0.514-1.2,1.371-1.2c0.771,0,1.286,0.514,1.286,1.2S8.551,8.717,7.694,8.717z M18,17h-2.442v-3.826c0-1.058-0.651-1.302-0.895-1.302s-1.058,0.163-1.058,1.302c0,0.163,0,3.826,0,3.826h-2.523v-7h2.523v0.977 C13.93,10.407,14.581,10,15.802,10C17.023,10,18,10.977,18,13.174V17z"></path>
                                    </svg>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    `
}
