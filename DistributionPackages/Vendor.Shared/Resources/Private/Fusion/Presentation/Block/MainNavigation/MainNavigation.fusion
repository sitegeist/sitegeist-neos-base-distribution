prototype(Vendor.Shared:Block.MainNavigation) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Vendor\\Shared\\Presentation\\Block\\MainNavigation\\MainNavigation'

    @styleguide {
        title = 'Site Header'
    }

    renderer = afx`
        <div class="[MainNavigation] h-full">
            <div class="contents lg:block h-full">
                <div
                    class={[
                        "lg:contents",
                        "absolute top-0 right-0 h-dvh w-0 max-w-dvw pt-header bg-white z-10",
                        "transition-all duration-500 ease-in-out",
                        "group-data-open/SiteHeader:w-full md:group-data-open/SiteHeader:w-80"
                    ]}
                    data-offcanvas-menu
                >
                    <div class="lg:contents overflow-y-auto max-h-full overflow-x-hidden">
                        <ul class={[
                            "list-none p-10 w-dvw flex flex-col gap-5",
                            "md:w-80 lg:flex-row lg:p-0 lg:h-full lg:w-full"
                        ]}>
                            <Neos.Fusion:Loop items={presentationObject.items}>
                                <Vendor.Shared:Block.MainNavigation.MainNavigationItem
                                    presentationObject={item}
                                />
                            </Neos.Fusion:Loop>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    `
}
