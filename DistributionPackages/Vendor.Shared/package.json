{
  "name": "@vendor/shared",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "yarn clean:build && yarn build:all",
    "watch": "yarn watch:css & yarn watch:js",
    "build:all": "yarn build:js & yarn build:css",
    "build:js": "yarn build:root-js & yarn build:components-js",
    "build:root-js": "vite build -c vite.config.ts",
    "build:components-js": "vite build -c vite.components.config",
    "watch:js": "vite build -c vite.components.config --watch",
    "build:css": "tailwindcss -i ./Resources/Private/Styles/Styles.css -o ./Resources/Public/Build/Styles/main.min.css --minify",
    "watch:css": "tailwindcss -i ./Resources/Private/Styles/Styles.css -o ./Resources/Public/Build/Styles/main.min.css --watch",
    "clean:build": "rm -rf ./Resources/Public/Build/*",
    "lint": "eslint Resources/Private/**/*.{ts,tsx}"
  },
  "dependencies": {
    "classnames": "^2.3.1",
    "final-form": "^4.20.2",
    "final-form-focus": "^1.1.2",
    "keen-slider": "^5.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-final-form": "^6.5.9",
    "rxjs": "^7.3.0"
  },
  "devDependencies": {
    "@sitegeist/eslint-config-es-neos-eslint": "^2.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/classnames": "^2.3.1",
    "@types/final-form-focus": "^1.1.1",
    "@types/glob": "^7.1.4",
    "@types/react": "^17.0.34",
    "@types/react-dom": "^17.0.11",
    "@typescript-eslint/eslint-plugin": "^4.30.0",
    "@typescript-eslint/parser": "^4.30.0",
    "autoprefixer": "^10.3.4",
    "concurrently": "^6.2.1",
    "cssnano": "^5.0.8",
    "esbuild-loader": "^4.0.2",
    "eslint": "^7.32.0",
    "eslint-plugin-react": "^7.25.1",
    "glob": "^7.1.7",
    "lerna": "^4.0.0",
    "node": "^16.6.1",
    "postcss": "^8.3.6",
    "postcss-cli": "^8.3.1",
    "postcss-discard-duplicates": "^5.0.1",
    "postcss-selector-parser": "^6.0.6",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.2.1",
    "typescript": "^4.4.2",
    "webpack": "^5.52.0",
    "webpack-cli": "^4.8.0",
    "vite": "^6.1.0"
  }
}
