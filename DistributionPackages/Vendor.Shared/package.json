{
	"name": "@vendor/shared",
	"version": "1.0.0",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "yarn build:js & yarn build:css",
		"watch": "yarn watch:css & yarn watch:js",
		"build:js": "vite build -c vite.config.ts",
		"watch:js": "vite build -c vite.config.ts --watch",
		"build:css": "tailwindcss -i ./Resources/Private/Styles/Styles.css -o ./Resources/Public/Build/Styles/main.min.css --minify",
		"watch:css": "tailwindcss -i ./Resources/Private/Styles/Styles.css -o ./Resources/Public/Build/Styles/main.min.css --watch",
		"lint": "eslint Components/**/*.{ts,tsx}"
	},
	"dependencies": {
		"@shoelace-style/shoelace": "2.20.1",
		"@tanstack/react-query": "5.90.20",
		"clsx": "2.1.1",
		"react": "^19.2",
		"react-dom": "^19.2",
		"tailwind-merge": "3.4.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@types/node": "25.2.2",
		"@types/react": "^19.2",
		"@types/react-dom": "^19.2",
		"@vitejs/plugin-react": "5.1.3"
	}
}
