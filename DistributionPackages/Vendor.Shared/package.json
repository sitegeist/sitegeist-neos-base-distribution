{
  "name": "@vendor/shared",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "build": "yarn build:js & yarn build:css",
    "build:js": "webpack --mode production",
    "build:css": "NODE_ENV=production tailwindcss -i Resources/Private/Styles/styles.css -o Resources/Public/Build/Styles/main.min.css --minify",
    "watch": "yarn watch:js & yarn watch:css",
    "watch:js": "webpack -w --mode development",
    "watch:css": "NODE_ENV=development tailwindcss -i Resources/Private/Styles/styles.css -o Resources/Public/Build/Styles/main.min.css --watch",
    "lint": "eslint 'Resources/Private/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "classnames": "^2.3.1",
    "final-form": "^4.20.2",
    "final-form-focus": "^1.1.2",
    "keen-slider": "^5.5.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-final-form": "^6.5.3",
    "rxjs": "^7.3.0"
  },
  "devDependencies": {
    "@types/classnames": "^2.3.1",
    "@types/react": "^17.0.34",
    "@types/react-dom": "^17.0.11"
  }
}
