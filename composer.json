{
	"name": "sitegeist/neos-base-distribution",
	"description": "Sitegeist Neos Base Distribution",
	"config": {
		"vendor-dir": "Packages/Libraries",
		"bin-dir": "bin",
		"allow-plugins": {
			"neos/composer-plugin": true
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"require": {
		"neos/neos": "^9.1",
		"neos/contentgraph-doctrinedbaladapter": "^9.1",
		"neos/neos-ui": "^9.1",
		"neos/redirecthandler": "^6.0",
		"neos/redirecthandler-databasestorage": "*",
		"neos/redirecthandler-neosadapter": "^5.0",
		"neos/redirecthandler-ui": "^3.0",

		"flowpack/nodetemplates": "^3.0",

		"packagefactory/neos-component-engine": "dev-editableString as 1.0.0-alpha3",
		"packagefactory/component-engine": "1.0.0-alpha3 as 1.0.0-alpha4",
		"packagefactory/neos-componentview": "^1.0",

		"sitegeist/csvpo": "^2.0",
		"sitegeist/iconoclasm": "^2.1",
		"sitegeist/inspectorgadget": "^3.0",
		"sitegeist/kaleidoscope": "^7.0",
		"sitegeist/kaleidoscope-valueobjects": "^1.6.0",
		"sitegeist/kaleidoscope-cpx": "dev-main",
		"sitegeist/klarschiff": "^3.0",
		"sitegeist/monocle": "dev-task/refactorToEnableUseCasesBeyondFusion",
		"sitegeist/papertiger-cpx": "dev-main",
		"sitegeist/schemeonyou": "^2.1.0",
		"sitegeist/stampede": "^2.0",

		"vendor/wheelinventor": "*",
		"neos/symfonymailer": "^1.0.2",
		"altcha-org/altcha": "^2.0",
		"packagefactory/opgm-neosadapter": "dev-main",
		"packagefactory/neos-seo": "dev-main",
		"packagefactory/opgm-contentrepositoryregistryadapter": "dev-main",
		"packagefactory/opgm": "dev-main",
		"packagefactory/opgm-timeablenodevisibility": "dev-main",
		"packagefactory/neos-seo-jobqueue": "dev-main"
	},
	"require-dev": {
		"neos/buildessentials": "^9.0",
		"mikey179/vfsstream": "^1.6.10",
		"squizlabs/php_codesniffer": "^4.0",
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^10.0",
		"symfony/css-selector": "~2.0",
		"neos/behat": "^9.0",
		"neos/contentrepository-testsuite": "^9.0",
		"neos/contentrepositoryregistry-testsuite": "^9.0",
		"behat/behat": "^3.0",
		"deployer/deployer": "^7.0",
		"editorconfig-checker/editorconfig-checker": "^10.0",
		"sitegeist/magicwand": "^4.4",
		"sitegeist/chantalle": "^2.0",
		"spaze/phpstan-disallowed-calls": "^4.13"
	},
	"suggest": {
		"ext-pdo_sqlite": "For running functional tests out-of-the-box this is required"
	},
	"scripts": {
		"post-update-cmd": "Neos\\Flow\\Composer\\InstallerScripts::postUpdateAndInstall",
		"post-install-cmd": "Neos\\Flow\\Composer\\InstallerScripts::postUpdateAndInstall",
		"post-package-update": "Neos\\Flow\\Composer\\InstallerScripts::postPackageUpdateAndInstall",
		"post-package-install": "Neos\\Flow\\Composer\\InstallerScripts::postPackageUpdateAndInstall",
		"post-create-project-cmd": "ddev config --project-name=`basename \"$PWD\"`",
		"build:cpx": "./flow components:build 'PackageFactory.Neos.Seo, Vendor.Shared'",
		"flush": [
			"./flow flow:cache:flush --force",
			"./flow flow:package:rescan",
			"./flow doctrine:migrate",
			"./flow resource:publish"
		],

		"cleanup:php": [
			"rm -rf ./Data/Temporary/*",
			"rm -rf ./Packages/*",
			"rm -rf ./bin/*"
		],

		"lint:editorconfig": "ec",
		"lint:phpcs": "phpcs --colors --standard=PSR12 ./DistributionPackages/*/Classes",
		"lint:phpcs-opgm": "phpcs --colors --standard=PSR12 ./Packages/Application/PackageFactory.OPGM ./Packages/Application/PackageFactory.OPGM.ContentRepositoryRegistryAdapter ./Packages/Application/PackageFactory.OPGM.NeosAdapter ./Packages/Application/PackageFactory.OPGM.TimeableNodeVisibility",
		"lint:phpcs-seo": "phpcs --colors --standard=PSR12 ./Packages/Application/PackageFactory.Neos.Seo/Classes ./Packages/Application/PackageFactory.Neos.Seo/NodeTypes",
		"lint:phpstan": "phpstan analyse",
		"lint:phpstan-seo": "phpstan analyse -c phpstan.seo.neon -vvv",
		"lint:phpstan-opgm": "phpstan analyse -c phpstan.opgm.neon -vvv",
		"lint": [
			"@lint:phpcs",
			"@lint:phpstan"
		],
		"lint:opgm": [
			"@lint:phpcs-opgm",
			"@lint:phpstan-opgm"
		],
		"lint:seo": [
			"@lint:phpcs-seo",
			"@lint:phpstan-seo"
		],

		"clone": [
			"./flow clone:list",
			"./flow clone:preset"
		],

		"deploy:develop": "dep deploy develop -vv",
		"deploy:staging": "dep deploy staging -vv",
		"deploy:master": "dep deploy master -vv",

		"test": "echo \"No tests yet.\"",

		"test:opgm": [
			"cd Packages/Application/PackageFactory.OPGM && phpunit Tests/Unit",
			"FLOW_CONTEXT=Testing/Behat ./flow doctrine:migrate",
			"cd Packages/Application/PackageFactory.OPGM && behat -f progress --strict -c Tests/Behaviour/behat.yml.dist -vvv"
		]
	},
	"autoload": {
		"psr-4": {
			"Sitegeist\\MissionAccessible\\": "Packages/Plugins/Sitegeist.MissionAccessible/Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"PackageFactory\\OPGM\\Tests\\": [
				"Packages/Application/PackageFactory.OPGM/Tests"
			]
		}
	},
	"repositories": {
		"sitegeist/monocle": {
			"type": "vcs",
			"url": "https://github.com/sitegeist/Sitegeist.Monocle"
		},
		"sitegeist/kaleidoscope-cpx": {
			"type": "vcs",
			"url": "https://github.com/sitegeist/Sitegeist.Kaleidoscope.Cpx"
		},
		"sitegeist/papertiger-cpx": {
			"type": "vcs",
			"url": "https://github.com/Devclaim/Sitegeist.PaperTiger.CPX"
		},
		"packagefactory/opgm": {
			"type": "vcs",
			"url": "https://codeberg.org/PackageFactory/opgm"
		},
		"packagefactory/opgm-contentrepositoryregistryadapter": {
			"type": "vcs",
			"url": "https://codeberg.org/PackageFactory/opgm-contentrepositoryregistryadapter"
		},
		"packagefactory/opgm-neosadapter": {
			"type": "vcs",
			"url": "https://codeberg.org/PackageFactory/opgm-neosadapter"
		},
		"packagefactory/neos-seo": {
			"type": "vcs",
			"url": "https://codeberg.org/PackageFactory/neos-seo"
		},
		"packagefactory/neos-seo-jobqueue": {
			"type": "vcs",
			"url": "https://codeberg.org/PackageFactory/neos-seo-jobqueue"
		},
		"packagefactory/opgm-timeablenodevisibility": {
			"type": "vcs",
			"url": "https://codeberg.org/PackageFactory/opgm-timeablenodevisibility"
		},
		"local": {
			"type": "path",
			"url": "./DistributionPackages/*"
		}
	}
}
