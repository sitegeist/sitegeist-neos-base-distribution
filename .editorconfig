root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{yaml,yml,yaml.example}]
indent_size = 2

[{.eslintrc}]
indent_size = 2

[*.{css,js,ts,tsx,json,cpx}]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
